# Environment Variables for She Can Foundation Backend
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/shecan?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=yourSuperStrongSecretKey_ChangeThis!
JWT_EXPIRES_IN=1d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
